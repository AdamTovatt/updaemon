<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <Version>0.10.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Updaemon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Updaemon.Common\Updaemon.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="PluginAssets.json" LogicalName="PluginAssets.json" />
    <EmbeddedResource Include="..\PublishingWithUpdaemon.md" LogicalName="PublishingWithUpdaemon.md" />
  </ItemGroup>
</Project>
